        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Error Rate",
      "type": "timeseries",
      "targets": [
        { "expr": "job:http_errors:ratio5m", "legendFormat": "Error Rate" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "CPU Usage",
      "type": "timeseries",
      "targets": [
        { "expr": "instance:node_cpu_utilisation:rate5m", "legendFormat": "{{instance}}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
