      "id": 1,
      "title": "API Latency (p95/p99)",
      "type": "timeseries",
      "targets": [
        { "expr": "job:http_request_duration_seconds:p95", "legendFormat": "p95" },
        { "expr": "job:http_request_duration_seconds:p99", "legendFormat": "p99" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
